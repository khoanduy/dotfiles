#!/bin/sh
# enroll luks devices in /etc/crypttab into the tpm2 with systemd-cryptenroll.
# ubuntu with dracut only, safe to rerun.
#
# usage: housekeeping/skill-issue [pcr_ids]
#   pcr_ids   tpm2 pcr list to seal against (default: 4+7+8+9)
set -eu

grep -qs '^ID=ubuntu$' /etc/os-release || { echo '! not ubuntu, nothing to do' >&2; exit 1; }

pcrs=$(printf '%s' "${1:-4+7+8+9}" | tr , +)

[ -e /dev/tpmrm0 ] || { echo '! no /dev/tpmrm0, is there a tpm2 chip enabled in firmware?' >&2; exit 1; }
[ -s /etc/crypttab ] || { echo '! /etc/crypttab is empty, nothing to enroll' >&2; exit 1; }
command -v dracut >/dev/null 2>&1 || { echo '! dracut not installed' >&2; exit 1; }

echo '> installing tpm2-tools'
sudo apt-get install -y tpm2-tools

enrolled=
# one crypttab line per pass, split on whitespace; _ swallows keyfile and options:
#   dm_crypt-0  UUID=aaaa  none  luks   ->  name=dm_crypt-0  src=UUID=aaaa
# redirect, not a pipe, so $enrolled survives the loop
while read -r name src _; do
    case "$name" in ''|\#*) continue ;; esac
    case "$src" in
        UUID=*|LABEL=*|PARTUUID=*|PARTLABEL=*) dev=$(sudo findfs "$src" 2>/dev/null || true) ;;
        *) dev="$src" ;;
    esac
    [ -n "$dev" ] && [ -b "$dev" ] || { echo "* skip $src: no such block device"; continue; }
    sudo cryptsetup isLuks "$dev" 2>/dev/null || { echo "* skip $dev: not luks"; continue; }

    echo "> enrolling $dev to pcr $pcrs"
    # stdin is crypttab here, so prompt for the passphrase on the terminal
    sudo systemd-cryptenroll --wipe-slot=tpm2 --tpm2-device=auto --tpm2-pcrs="$pcrs" "$dev" </dev/tty
    enrolled="$enrolled $name"
done </etc/crypttab

[ -n "$enrolled" ] || { echo '* no luks devices enrolled'; exit 0; }

tmp=$(mktemp)
old=$(mktemp)
trap 'rm -f "$tmp" "$old"' EXIT
# add tpm2-device=auto to the options (4th field) of enrolled entries; others pass through.
# names is " a b " so index() matches whole names only.
#   dm_crypt-0  UUID=aaaa  none  luks   ->  dm_crypt-0 UUID=aaaa none luks,tpm2-device=auto
#   swap_crypt  UUID=bbbb               ->  swap_crypt UUID=bbbb none tpm2-device=auto
#   lines already having tpm2-device= are left alone, so reruns change nothing.
awk -v names="$enrolled " '
    /^[[:space:]]*#/ || NF < 2 || index(names, " " $1 " ") == 0 || $4 ~ /(^|,)tpm2-device=/ { print; next }
    {
        if (NF < 3) $3 = "none"
        opts = NF < 4 ? "tpm2-device=auto" : $4 ",tpm2-device=auto"
        $4 = opts
        print
    }' /etc/crypttab > "$tmp"

if cmp -s "$tmp" /etc/crypttab; then
    echo '* crypttab already up to date'
    exit 0
fi

echo '> adding tpm2-device=auto to crypttab and rebuilding the initramfs'
[ -e /etc/crypttab.bak ] || sudo cp /etc/crypttab /etc/crypttab.bak
cp /etc/crypttab "$old"
sudo cp "$tmp" /etc/crypttab
sudo dracut -f --regenerate-all || {
    sudo cp "$old" /etc/crypttab
    echo '! dracut failed, crypttab restored' >&2
    exit 1
}

case "+$pcrs+" in
    *+9+*) echo '* pcr 9 changed: reboot with the passphrase, then rerun' ;;
esac
